# Build single compiled regex for performance
_UNICODE_PATTERN = re.compile(
    '|'.join(re.escape(k) for k in UNICODE_REPLACEMENTS.keys())
)

def sanitize_unicode(text):
    """Replace all known unicode characters before DB insert. No fallback needed."""
    if not isinstance(text, str):
        return text
    return _UNICODE_PATTERN.sub(lambda m: UNICODE_REPLACEMENTS[m.group(0)], text)


